{
  "manifest_version": 3,
  "name": "FactCheckAI Extension",
  "version": "1.0.0",
  "description": "Verify claims on the fly using Gemma 4",
  "browser_specific_settings": {
    "gecko": {
      "id": "factcheckai@factcheckai.local",
      "strict_min_version": "115.0"
    }
  },
  "permissions": [
    "activeTab",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
