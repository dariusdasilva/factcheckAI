# FactCheckAI backend environment — copy to .env and fill in real values.
# .env is gitignored; never commit real secrets (AGENTS.md §1).

# Core Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Deployment hardening (prod.py)
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_SECURE_HSTS_SECONDS=31536000

# CORS — only the web app origin belongs here (ARCHITECTURE.md §6)
CORS_ALLOWED_ORIGINS=http://localhost:8000

# Database — unset means local SQLite; postgres URL switches prod over
# DATABASE_URL=postgres://user:password@host:5432/factcheckai

# Chunk B (inference) — placeholder for now
OPENROUTER_API_KEY=
